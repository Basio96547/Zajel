{
  // The root tsconfig deliberately covers src/ only, so `npm run typecheck`
  // checks what deploys. This adds the tests, which need the `cloudflare:test`
  // module's types on top of the Workers ones, and pulls src/ back in so the
  // two are checked against each other rather than in isolation.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
