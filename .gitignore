# ============================================================
#  SecureMessenger — .gitignore
#  ملاحظة: هذا الملف ضُبط قبل أول commit عن قصد. أي تعديل عليه
#  لاحقاً لا يُخرج ملفاً دخل التاريخ فعلاً — يلزم إعادة كتابة
#  التاريخ لذلك. راجعه قبل إضافة أي مسار جديد يحوي أسراراً.
# ============================================================

# ---- مخرجات البناء (~600 م.ب، تُولَّد بالكامل) ----
build/
*/build/
.gradle/
.kotlin/

# ---- إعدادات محلية للجهاز، لا تُشارَك ----
local.properties

# ---- أسرار التوقيع ----
keystore.properties
*.jks
*.keystore

# ---- Android ----
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/

# ---- بيئة التطوير ----
.idea/
*.iml
*.log
.DS_Store
Thumbs.db

# ---- الوسيط: Node و Cloudflare ----
# relay/.wrangler/ يحوي ملفات مؤقتة، وحساب Cloudflare يُخزَّن في
# .wrangler/ داخل المجلد الأب (خارج هذا المستودع أصلاً). كلاهما
# مستبعَد هنا احتياطاً لو نُقل المستودع لأعلى لاحقاً.
node_modules/
.wrangler/
dist/
